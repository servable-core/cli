{
  "name": "@servable/cli",
  "type": "module",
  "version": "0.0.0-development",
  "description": "",
  "author": {
    "name": "Servable",
    "email": "servablecommunity@gmail.com"
  },
  "license": "MIT",
  "bin": {
    "servable": "src/app.js"
  },
  "source": "src/app.js",
  "exports": {
    "require": "./dist/app.cjs",
    "default": "./dist/app.modern.js"
  },
  "main": "./dist/app.modern.js",
  "module": "./dist/app.module.js",
  "unpkg": "./dist/app.umd.js",
  "types": "types/app.d.ts",
  "scripts": {
    "build": "microbundle",
    "build:types": "tsc",
    "test:types": "tsc --noEmit",
    "dev": "microbundle watch --no-compress --format modern,cjs",
    "test_": "echo \"Error: no test specified\" && exit 1",
    "semantic-release": "semantic-release",
    "acp": "git add . && npm run commit && git push",
    "commit": "git-cz",
    "start": "microbundle-crl watch --no-compress --format modern,cjs",
    "prepare_": "run-s build",
    "test": "run-s test:unit test:lint test:build",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "yarn node --experimental-vm-modules --experimental-specifier-resolution=node $(yarn bin jest) --config ./jest.config.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "global.d.ts",
    ".env"
  ],
  "engines": {
    "node": ">=20"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/servable-core/cli"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "keywords": [],
  "dependencies": {
    "@clinext/chunks-extension": "^1.1.0",
    "@clinext/sdk": "^2.6.3",
    "@servable/tools": "^2.0.0",
    "axios": "^1.6.1",
    "bluebird": "^2.11.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.0.1",
    "ejs": "^3.1.9",
    "fuzzy": "^0.1.3",
    "get-port": "^7.0.0",
    "glob": "^10.3.10",
    "glob-fs": "^0.1.7",
    "inspirational-quotes": "^2.0.1",
    "netrc": "^0.1.4",
    "underscore": "^1.13.6",
    "update-notifier": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@jest/globals": "^29.7.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-jsdoc": "^50",
    "eslint-plugin-n": "^17",
    "globals": "^15",
    "husky": "^6.0.0",
    "javascript-obfuscator": "^4.0.0",
    "jest": "^29.7.0",
    "microbundle": "^0.15.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.0.4",
    "semantic-release": "^22",
    "typescript": "^5"
  }
}
